{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "stripInternal": true,
    "skipLibCheck": true,
    "removeComments": true,
    "importHelpers": true,
    "types": [
      "vitest/globals",
    ],
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitOverride": true
  },
  "exclude": [
    "build/**/*",
    "index.d.ts"
  ]
}