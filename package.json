{
  "name": "webcrypto-core",
  "version": "1.9.2",
  "description": "Common layer to be used by crypto libraries based on WebCrypto API for input validation.",
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest --coverage",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/webcrypto-core"
  },
  "keywords": [
    "webcrypto",
    "crypto",
    "polyfill",
    "aes",
    "rsa",
    "sha",
    "ec",
    "shake"
  ],
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@peculiar/asn1-schema": "^2.10.0",
    "@peculiar/json-schema": "^2.0.0",
    "@peculiar/utils": "^3.0.0",
    "asn1js": "^3.0.10"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "author": "PeculiarVentures",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeculiarVentures/webcrypto-core/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/webcrypto-core#readme"
}
