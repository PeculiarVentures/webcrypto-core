{
  "name": "webcrypto-core",
  "version": "2.0.0",
  "description": "Common layer to be used by crypto libraries based on WebCrypto API for input validation.",
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/webcrypto-core"
  },
  "keywords": [
    "webcrypto",
    "crypto",
    "polyfill",
    "aes",
    "rsa",
    "sha",
    "ec",
    "shake"
  ],
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@peculiar/utils": "^4.1.0"
  },
  "peerDependencies": {
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/json-schema": "^3.0.0",
    "asn1js": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/json-schema": "^3.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "asn1js": "^4.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "author": "PeculiarVentures",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeculiarVentures/webcrypto-core/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/webcrypto-core#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
